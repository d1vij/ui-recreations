{
    "name": "ui-recreations",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "bun gen && wrangler types --check && vite build",
        "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
        "prepare": "svelte-kit sync || echo ''",
        "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check --write . && eslint .",
        "format": "prettier --write .",
        "gen": "wrangler types"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/enhanced-img": "^0.10.4",
        "@sveltejs/kit": "^2.59.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^24.12.3",
        "@types/youtube-player": "^5.5.11",
        "autoprefixer": "^10.5.0",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.17.1",
        "globals": "^17.6.0",
        "postcss-load-config": "^6.0.1",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.7.4",
        "rollup-plugin-visualizer": "^7.0.1",
        "svelte": "^5.55.5",
        "svelte-check": "^4.4.8",
        "tailwindcss": "^4.3.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.2",
        "vite": "^7.3.3",
        "wrangler": "^4.81.0"
    },
    "dependencies": {
        "@d1vij/shit-i-always-use": "^0.1.26",
        "@lucide/svelte": "^1.14.0",
        "@tanstack/svelte-hotkeys": "^0.9.1",
        "nanoid": "^5.1.11",
        "radashi": "^12.9.0",
        "runed": "^0.37.1",
        "tailwind-merge": "^3.5.0",
        "tailwind-variants": "^3.2.2",
        "valibot": "^1.4.0",
        "youtube-player": "^5.6.0"
    }
}
